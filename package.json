{
  "name": "newsdeck",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Self-hosted tech news dashboard: your own RSS and Atom feeds, refreshed every minute. Mobile-friendly PWA, deploys free to Cloudflare Workers.",
  "keywords": [
    "rss",
    "rss-reader",
    "feed-reader",
    "atom",
    "news-aggregator",
    "tech-news",
    "dashboard",
    "self-hosted",
    "pwa",
    "cloudflare-workers"
  ],
  "homepage": "https://github.com/ae3ch/newsdeck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ae3ch/newsdeck.git"
  },
  "bugs": {
    "url": "https://github.com/ae3ch/newsdeck/issues"
  },
  "author": "ae3ch",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"wrangler dev --port 8788\"",
    "predev": "mkdir -p dist",
    "build": "vite build",
    "preview": "npm run build && wrangler dev --port 8788",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
